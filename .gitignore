# ==============================================================================
# .gitignore para Proyecto Barbería Harry Estilos (SENA ADSO)
# ==============================================================================

# Directorios de compilación Maven
target/
**/target/
*.class

# Empaquetados binarios temporales
*.war
*.ear
*.nar

# Dependencias y compilados de Node / Frontend Vite
node_modules/
dist/
dist-ssr/
*.local

# Archivos de configuración de IDEs
.idea/
*.iml
.vscode/
.project
.classpath
.settings/

# Archivos del sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Logs y volcados temporales
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
