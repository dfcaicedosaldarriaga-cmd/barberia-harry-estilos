          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Devuelve la cita creada con id', function () {",
              "    var body = pm.response.json();",
              "    pm.expect(body.id).to.be.a('number');",
